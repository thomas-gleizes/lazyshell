# Env and Usage tabs, then switching between projects.
Output docs/assets/panels.gif

Set Shell bash
Set FontSize 15
Set Width 1200
Set Height 680
Set Padding 12
Set Theme "Catppuccin Mocha"
Set Framerate 15
Set TypingSpeed 80ms

Hide
Type `cd "$DEMO_ROOT/acme-shop" && clear`
Enter
Sleep 500ms
Type "lazyshell"
Enter
Sleep 1s
Type "jj"
Sleep 1s
Show

Sleep 2s
Tab
Sleep 3s
Tab
Sleep 3s
Tab
Sleep 1s

# Projects panel: every running daemon, one keypress away.
Type "1"
Sleep 800ms
Type "j"
Sleep 800ms
Enter
Sleep 3.5s
Type "1"
Sleep 500ms
Type "k"
Sleep 800ms
Enter
Sleep 2.5s
